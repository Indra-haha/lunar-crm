# Database PostgreSQL Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lunar_crm
LUNAR_DB_NAME=lunar_crm
LUNAR_DB_USER=svc_lunar
LUNAR_DB_PASSWORD=your_secure_db_password

# Application Security (generate with: openssl rand -hex 32)
SESSION_SECRET=your_super_secret_64_hex_token_here

# Next.js Development HMR Allowed Origins
ALLOWED_DEV_ORIGINS=lunar.deera-server.my.id,*.deera-server.my.id
